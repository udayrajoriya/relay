{
  "name": "relay-download-manager",
  "version": "0.1.0",
  "description": "A Windows download manager with segmented transfers and persistent queues",
  "main": "src/main.js",
  "author": "Relay",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": { "start": "electron .", "test": "node --test test/*.test.js", "dist": "electron-builder --win portable", "pack": "electron-builder --dir" },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.15.3" },
  "build": { "appId": "local.relay.downloads", "productName": "Relay", "files": ["src/**/*", "package.json"], "extraResources": [{"from":"extension","to":"extension"}], "win": { "target": "portable", "icon":"src/assets/icon.ico", "signExecutable": false }, "portable": { "artifactName": "Relay-${version}-Windows.exe" } }
}
